{
  "schemaVersion": 1,
  "id": "saas-blueprint",
  "name": "SaaS Blueprint",
  "description": "Multi-tenant SaaS boilerplate (Next.js 16 App Router, TypeScript, Prisma/PostgreSQL, NextAuth.js) implementing a request/approval workflow product with billing (Paddle), R2-backed file evidence, an AI-searchable knowledge base, and a support/help center.",
  "domain": "software-engineering",
  "repository": {
    "type": "git",
    "expectedRemote": "https://github.com/oscaralfaguz47/saas-blueprint.git",
    "defaultBranch": "main",
    "requireCleanWorkingTree": true
  },
  "agents": {
    "allowed": [
      "software-engineering.code-reviewer",
      "software-engineering.software-architect",
      "software-engineering.implementer"
    ],
    "defaultAgent": "software-engineering.implementer"
  },
  "knowledge": {
    "projectId": "saas-blueprint",
    "allowedScopes": ["global", "domain:software-engineering", "project:active"]
  },
  "tools": {
    "allowedCapabilities": [
      "filesystem.read",
      "filesystem.write",
      "git.read",
      "validation.test",
      "validation.typecheck",
      "validation.lint",
      "validation.format-check"
    ]
  },
  "writePolicy": {
    "allowedPaths": ["src/test/lib/slug.test.ts"],
    "allowCreate": true,
    "allowModify": false,
    "allowGitStage": false,
    "allowGitCommit": false
  },
  "runtime": { "preferredAdapter": "opencode", "headlessAllowed": true },
  "validation": {
    "commands": {
      "test": {
        "capability": "validation.test",
        "executable": "pnpm",
        "args": ["test"],
        "timeoutMs": 120000,
        "networkRequired": false
      },
      "typecheck": {
        "capability": "validation.typecheck",
        "executable": "pnpm",
        "args": ["tsc", "--noEmit"],
        "timeoutMs": 120000,
        "networkRequired": false
      },
      "lint": {
        "capability": "validation.lint",
        "executable": "pnpm",
        "args": ["lint"],
        "timeoutMs": 60000,
        "networkRequired": false
      },
      "format-check": {
        "capability": "validation.format-check",
        "executable": "pnpm",
        "args": ["format:check"],
        "timeoutMs": 60000,
        "networkRequired": false
      }
    }
  },
  "secrets": [],
  "ephemeralArtifactPaths": [
  "node_modules/.vite/vitest"
]
}
