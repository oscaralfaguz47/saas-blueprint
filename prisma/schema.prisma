  fileName        String? @db.VarChar(255)
  mimeType        String? @db.VarChar(120)
  sizeBytes       Int?
  sha256          String? @db.VarChar(64)

  versionNumber Int @default(1)

  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  createdByUserId String?
  createdByUser   User?    @relation("RecordPaymentEvidenceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  removedAt       DateTime? @db.Timestamptz(6)
  removedByUserId String?
  removedByUser   User?     @relation("RecordPaymentEvidenceRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, recordId, createdAt])
  @@index([tenantId, paymentId, removedAt])
}

model RecordReminderLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation("TenantRecordReminderLogs", fields: [tenantId], references: [id], onDelete: Cascade)

  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  sentAt           DateTime @default(now()) @db.Timestamptz(6)
  sentByUserId     String?
  sentByUser       User?    @relation("RecordReminderLogSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  recipientsCount  Int      @default(0)

  metadata Json?

  @@index([tenantId, recordId, sentAt])
}

model RecordExport {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation("TenantRecordExports", fields: [tenantId], references: [id], onDelete: Cascade)

  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  exportType RecordExportType

  storageProvider String @db.VarChar(30)
  objectKey       String @db.VarChar(512)
  fileName        String @db.VarChar(255)
  sizeBytes       Int?
  sha256          String? @db.VarChar(64)

  watermarkApplied Boolean @default(false)

  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  createdByUserId String?
  createdByUser   User?    @relation("RecordExportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, recordId, exportType, createdAt])
}


//
// NextAuth Models (unchanged)
//
model AuthLinkChallenge {
  id                      String    @id @default(cuid())
  userId                  String
  email                   String    @db.VarChar(191)
  targetProvider          String    @db.VarChar(50)
  targetProviderAccountId String    @db.VarChar(191)
  targetProviderTenantId  String?   @db.VarChar(191)
  callbackUrl             String?   @db.VarChar(500)

  // SHA-256 hash of the raw token. Raw token never persisted beyond pendingRawToken.
  tokenHash               String    @unique @db.VarChar(64)

  // Raw token stored ONLY until the browser cookie is issued (seconds).
  // Cleared by /api/link/pending immediately after setting the cookie.
  // Never logged, never returned in API responses.
  pendingRawToken         String?   @db.VarChar(191)

  // Set when /api/link/pending issues the cookie.
  // Used as a gate in finalization — challenges that never reached the
  // browser are rejected.
  cookieIssuedAt          DateTime?

  expiresAt               DateTime
  consumedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Rate limiting for magic link sends (used by /api/link/send-email).
  lastSentAt              DateTime?
  sendCount               Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@index([pendingRawToken])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  // Microsoft Entra ID (azure-ad) returns ext_expires_in in the token response.
  // The adapter passes all token fields to account.create(), so this field must
  // exist in the schema or Prisma rejects the entire sign-in with a validation error.
  ext_expires_in    Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())

  // Sliding inactivity (global policy uses user.security)
  lastActivityAt DateTime @default(now())

  // MFA gating
  authLevel             SessionAuthLevel @default(FULL)
  mfaVerifiedAt         DateTime?
  mfaChallengeExpiresAt DateTime?

  // Revocation / hard logout
  revokedAt    DateTime?
  logoutReason String?  @db.VarChar(50)

  // Lightweight device telemetry
  ipFirstSeen String? @db.VarChar(64)
  lastIp      String? @db.VarChar(64)
  // Location (from Vercel geolocation headers or IP lookup)
  location    String?  @db.VarChar(150)
  userAgent   String? @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([userId, authLevel])
  @@index([userId, revokedAt])
}

model RateLimit {
  id      String   @id @default(cuid())
  key     String
  count   Int      @default(1)
  resetAt DateTime

  @@unique([key])
  @@index([resetAt])
}

model RememberedDevice {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.VarChar(64)

  label       String? @db.VarChar(80)
  userAgent   String? @db.VarChar(300)
  ipFirstSeen String? @db.VarChar(64)

  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

/// WebAuthn/Passkey credentials for passwordless authentication.
model WebAuthnCredential {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // WebAuthn credential fields
  credentialId   String   @unique @db.VarChar(512)
  publicKey      Bytes
  counter        BigInt   @default(0)
  deviceType     String   @db.VarChar(32)   // "singleDevice" | "multiDevice"
  backedUp       Boolean  @default(false)
  transports     String[] @default([])       // "usb" | "ble" | "nfc" | "internal" | "hybrid"

  // Display
  name           String?  @db.VarChar(100)  // user-friendly name e.g. "MacBook Touch ID"
  aaguid         String?  @db.VarChar(36)   // authenticator AAGUID for device identification

  // Timestamps
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?

  @@index([userId])
  @@index([credentialId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

/// Short-lived OTP code for email sign-in (6 digits, 10 minute TTL).
/// Separate from NextAuth VerificationToken — this is for the UI code input.
model EmailVerificationCode {
  id         String   @id @default(cuid())
  email      String   @db.VarChar(191)
  codeHash   String   @db.VarChar(64)   // SHA-256 of the 6-digit code
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int      @default(0)       // rate-limit brute force
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// Short-lived one-time token for OTP/Passkey → NextAuth session handoff.
/// Replaces the in-memory token store which doesn't work across serverless instances.
model OtpSessionToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.VarChar(64)
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum NotificationType {
  SUPPORT_TICKET_REPLY
  SUPPORT_TICKET_STATUS_CHANGED
  SUPPORT_TICKET_USER_REPLIED
  SUPPORT_TICKET_ASSIGNED
  RECORD_APPROVAL_FULLY_COMPLETED
  RECORD_FINANCE_ASSIGNED
  RECORD_PAYMENT_STATUS_CHANGED
}

enum NotificationCategory {
  SECURITY
  BILLING
  WORKFLOW
  FINANCE
  SOCIAL
}

/// In-app notifications for workspace users.
/// Extensible: notificationType covers support tickets today, other sources in the future.
model UserNotification {
  id               String                 @id @default(cuid())
  userId           String
  notificationType NotificationType
  category         NotificationCategory
  title            String                 @db.VarChar(255)
  body             String?                @db.VarChar(500)
  entityType       String                 @db.VarChar(80)
  entityId         String                 @db.VarChar(191)
  actionUrl        String?                @db.VarChar(512)
  readAt           DateTime?
  createdAt        DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([userId, category, readAt])
}
