generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum RoleKey {
  ADMIN
  MANAGER
  MEMBER
}

enum TenantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// A5: Invitation lifecycle (PENDING | ACCEPTED | REJECTED | REVOKED | EXPIRED)
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

enum PermissionScope {
  TENANT
  VENDOR
  BOTH
}

enum ActorContext {
  TENANT
  VENDOR
}

/// L1 My Account: user appearance preference
enum AppearanceMode {
  LIGHT
  DARK
  SYSTEM
}

/// Security 2FA/sessions: MFA gating
enum SessionAuthLevel {
  FULL
  PENDING_MFA
}

enum RecordType {
  SCOPE_CHANGE
  DECISION
  BUDGET
}

enum RecordVisibility {
  WORKSPACE
  RESTRICTED
}

enum MeterKey {
  REQUESTS
  PDF_EXPORTS
  ZIP_EXPORTS
}

enum BillingPeriodStatus {
  OPEN
  CLOSED
}

/// EPIC 5: Support request type for billing.
enum BillingSupportRequestType {
  INVOICE_BILLING_DETAILS_CHANGE
}

/// EPIC 5: Support request status.
enum BillingSupportRequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  REJECTED
}

enum RecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NO_RESPONSE
}

enum ApprovalRequestStatus {
  SENT
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
  NO_RESPONSE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // L1 My Account: profile and appearance
  phone                 String?         @db.VarChar(30)
  timezone              String?         @db.VarChar(64)
  appearance           AppearanceMode   @default(SYSTEM)
  profilePhotoObjectKey String?         @db.VarChar(512)

  // Legacy / compatibility role (keep for now)
  role RoleKey @default(MEMBER)

  // If you later move to an IdP, these fields become useful
  identityProvider String? @db.VarChar(50)
  identityId       String? @db.VarChar(191)

  isPlatformBlocked Boolean @default(false)

  locale String @db.VarChar(5) @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  rememberedDevices RememberedDevice[]

  security UserSecurity?

  tenantMemberships TenantMembership[]
  vendorUserRoles   VendorUserRole[]

  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTargetUser")

  tenantInvitationsSent   TenantInvitation[] @relation("TenantInvitedByUser")
  tenantInvitationsRejected TenantInvitation[] @relation("TenantInvitationRejectedByUser")
  recordsCreated Record[] @relation("RecordsCreatedByUser")
  tenantsCreated Tenant[] @relation("TenantCreatedByUser")
  workspaceMemberSecurity WorkspaceMemberSecurity[] @relation("WorkspaceMemberSecurity")
  authLinkChallenges AuthLinkChallenge[]
  accountLinkIntents AccountLinkIntent[]

  @@index([identityProvider, identityId])
}

/// Short-lived token for Settings → Link Google / Link Microsoft (email must match account).
model AccountLinkIntent {
  id             String    @id @default(cuid())
  userId         String
  targetProvider String    @db.VarChar(50)
  expectedEmail  String    @db.VarChar(191)
  tokenHash      String    @unique @db.VarChar(64)
  expiresAt      DateTime
  consumedAt     DateTime?
  // Set on email mismatch during Settings linking — redirect callback sends user back to Security.
  errorCode      String?   @db.VarChar(50)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model UserSecurity {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // For forced logout / session invalidation
  tokenVersion Int @default(0)

  // L1: TOTP 2FA
  totpEnabled          Boolean   @default(false)
  totpEnabledAt        DateTime?
  totpSecretEnc        String?   @db.VarChar(500)
  totpPendingSecretEnc String?   @db.VarChar(500)
  backupCodeHashes     String[]  @default([])
  backupCodesGeneratedAt DateTime?

  // L1: Inactivity auto-logout (minutes: 15, 30, 60, 480, 10080, 21600). Default 21600 = 15 days.
  autoLogoutEnabled   Boolean @default(false)
  autoLogoutMinutes   Int     @default(21600)
  forceLogoutAt       DateTime?

  // Mirror flags (actual MFA is typically enforced at IdP level)
  mfaEnabled  Boolean   @default(false)
  mfaEnforced Boolean   @default(false)
  mfaEnforcedByUserId String?  // E6: admin who forced 2FA
  mfaResetAt  DateTime?

  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([totpEnabled])
  @@index([autoLogoutEnabled])
  @@index([mfaEnforced])
}

/// E6: Per-workspace 2FA enforcement (decouples from global UserSecurity).
model WorkspaceMemberSecurity {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String

  mfaEnforced      Boolean   @default(false)
  enforcedByUserId  String?
  enforcedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("WorkspaceMemberSecurity", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique @db.VarChar(80)
  status TenantStatus @default(ACTIVE)

  // A5: first-time setup — creator and claim time
  createdByUserId String
  createdByUser   User   @relation("TenantCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  claimedAt       DateTime?

  // Workspace settings (A1)
  logoObjectKey String?  @db.VarChar(512)
  timezone      String?  @db.VarChar(64)
  currency      String?  @db.VarChar(10)
  dateFormat    String?  @db.VarChar(32)
  description   String?  @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TenantMembership[]
  invitations TenantInvitation[]

  records Record[]

  tenantRoles   TenantRole[]
  subscriptions Subscription[]

  auditLogs AuditLog[]

  featureFlags TenantFeatureFlag[]

  billingEvents BillingEvent[]

  workspaceMemberSecurity WorkspaceMemberSecurity[]

  tenantBillingStates   TenantBillingState[]
  tenantUsageCounters   TenantUsageCounter[]
  tenantUsageLedgers    TenantUsageLedger[]
  billingTransactions  BillingTransaction[]

  /// EPIC 5: Billing profile snapshot (future invoices; Country/Postal locked).
  tenantBillingProfile   TenantBillingProfile?
  /// EPIC 5: Support requests for existing invoice billing detail changes.
  billingSupportRequests BillingSupportRequest[]
  /// EPIC 5: Rollover lots (paid plans; 60d expiry, cap 400 for Starter).
  tenantRolloverLots    TenantRolloverLot[]
  /// EPIC 5: Scheduled overage charges (Starter; one-time on next invoice).
  tenantOverageCharges  TenantOverageCharge[]

  @@index([status])
  @@index([createdByUserId])
  @@index([createdByUserId, status])
  @@index([createdAt, id])
}

/// EPIC 4: Transaction history for Billing tab (invoice link, display). No PII stored.
model BillingTransaction {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider               String    @db.VarChar(30)
  providerTransactionId  String    @unique @db.VarChar(191)

  status                 String    @db.VarChar(40)
  billedAt               DateTime?

  currency               String    @db.VarChar(10)
  subtotalCents          Int
  taxCents               Int
  totalCents             Int

  /// Paddle invoice id (inv_xxx) from transaction.completed; used to fetch hosted_invoice_url on "Open".
  providerInvoiceId      String?   @db.VarChar(191)
  invoiceUrl             String?   @db.VarChar(600)
  receiptNumber          String?   @db.VarChar(120)

  planCode               String?   @db.VarChar(50)
  subscriptionId         String?
  providerSubscriptionId String?   @db.VarChar(191)

  /// Invoice-specific edit: revised once via Paddle "Revise transaction customer details".
  revisedAt              DateTime?
  revisedByUserId        String?   @db.VarChar(191)
  revisionRequestPayload Json?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, billedAt])
  @@index([tenantId, status])
  @@index([provider, providerSubscriptionId])
}

/// EPIC 5: Billing profile snapshot for future invoices. Country/Postal locked (set by Paddle checkout).
model TenantBillingProfile {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  countryCode String   @db.VarChar(2)
  postalCode  String?  @db.VarChar(32)
  region      String?  @db.VarChar(80)
  city        String?  @db.VarChar(80)
  addressLine1 String? @db.VarChar(120)
  addressLine2 String? @db.VarChar(120)
  companyName  String? @db.VarChar(160)
  vatId        String? @db.VarChar(64)

  providerCustomerId String? @db.VarChar(191)
  providerBusinessId String? @db.VarChar(191)
  providerAddressId  String? @db.VarChar(191)

  lastSyncedAt DateTime?
  syncSource   String?   @db.VarChar(40)

  updatedByUserId String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([providerCustomerId])
  @@index([lastSyncedAt])
}

/// EPIC 5: Support request for existing invoice billing detail changes (platform admin handles).
model BillingSupportRequest {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   BillingSupportRequestType
  status BillingSupportRequestStatus @default(OPEN)

  providerInvoiceId     String? @db.VarChar(191)
  providerTransactionId String? @db.VarChar(191)
  requestedData         Json
  note                  String? @db.VarChar(500)

  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

/// EPIC 5: Rollover lots (paid plans); expiry 60d, cap 400 for Starter.
model TenantRolloverLot {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodStart DateTime
  granted     Int
  used        Int      @default(0)
  expiresAt   DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, expiresAt])
  @@index([tenantId, periodStart])
}

/// EPIC 5: Scheduled overage charges (Starter; one-time on next invoice).
model TenantOverageCharge {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart DateTime

  meter         MeterKey
  units         Int
  unitPriceCents Int
  totalCents    Int

  provider         String  @db.VarChar(30)
  providerChargeId String? @db.VarChar(191)
  status           String  @db.VarChar(40)

  createdAt DateTime @default(now())

  @@unique([tenantId, periodStart, meter])
  @@index([tenantId, createdAt])
}

model TenantMembership {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime?
  lastSeenAt DateTime?

  isDefaultTenant Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles TenantUserRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([tenantId, joinedAt])
  @@index([userId, status, isDefaultTenant, joinedAt])
}

model TenantInvitation {
  id       String   @id @default(cuid())
  tenantId String
  email    String   @db.VarChar(191)
  createdAt DateTime @default(now())

  tokenHash String   @unique @db.VarChar(191)
  expiresAt DateTime

  /// A5: Canonical status; backfill from acceptedAt/revokedAt/expiresAt in migration
  status InvitationStatus @default(PENDING)

  invitedByUserId String?
  revokedAt       DateTime?

  acceptedAt DateTime?

  /// A5: Set when user declines invite (in-app or via link)
  rejectedAt       DateTime?
  rejectedByUserId String?
  rejectedByUser   User?   @relation("TenantInvitationRejectedByUser", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedByUser User?  @relation("TenantInvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([expiresAt])
  @@index([status])
}

model Permission {
  id          String          @id @default(cuid())
  code        String          @unique @db.VarChar(120)
  description String?
  scope       PermissionScope @default(TENANT)

  tenantRolePermissions TenantRolePermission[]
  vendorRolePermissions VendorRolePermission[]
}

model TenantRole {
  id       String  @id @default(cuid())
  tenantId String
  name     String  @db.VarChar(80)
  isSystem Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions TenantRolePermission[]
  users       TenantUserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TenantRolePermission {
  roleId       String
  permissionId String

  role       TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model TenantUserRole {
  membershipId String
  roleId       String

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       TenantRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model VendorRole {
  id       String  @id @default(cuid())
  name     String  @unique @db.VarChar(80)
  isSystem Boolean @default(false)

  permissions VendorRolePermission[]
  users       VendorUserRole[]
}

model VendorRolePermission {
  roleId       String
  permissionId String

  role       VendorRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model VendorUserRole {
  userId String
  roleId String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role VendorRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Plan {
  id           String  @id @default(cuid())
  code         String  @unique @db.VarChar(50)
  name         String
  priceMonthly Int?
  priceYearly  Int?
  isActive     Boolean @default(true)

  featuresJson Json?

  subscriptions Subscription[]

  @@index([isActive])
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String
  planId   String

  status SubscriptionStatus @default(TRIAL)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceUntil         DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  /** Target plan when cancelAtPeriodEnd is true; applied at period end by period-close/cron. */
  pendingPlanCode    String?   @db.VarChar(50)
  /** Set when we called Paddle on downgrade with prorated_next_billing_period; period-close then only updates DB. */
  downgradePaddleAppliedAt DateTime? @db.Timestamptz(6)

  /** What Paddle will bill next (from subscription items). */
  billingPlanCode         String?   @db.VarChar(50)
  /** Plan that controls feature access now; stays higher until entitlementEffectiveUntil when downgrade pending. */
  currentEntitlementPlanCode String? @db.VarChar(50)
  /** Until when currentEntitlementPlanCode remains active (for scheduled downgrade/cancel). */
  entitlementEffectiveUntil DateTime? @db.Timestamptz(6)
  /** none | downgrade_end_of_period | cancel_to_free_end_of_period */
  pendingChangeType       String?   @db.VarChar(50)
  /** When the pending change takes effect (period end). */
  pendingEffectiveAt      DateTime? @db.Timestamptz(6)

  /** healthy | past_due | canceled */
  paymentStatus           String?   @db.VarChar(30)
  pastDueSince            DateTime? @db.Timestamptz(6)
  graceEndsAt             DateTime? @db.Timestamptz(6)
  lastPaymentFailureCode  String?   @db.VarChar(100)
  lastPaymentFailureMessage String? @db.VarChar(500)
  latestTransactionId     String?   @db.VarChar(191)

  provider               String? @db.VarChar(30) // stripe, paddle, manual
  providerCustomerId     String? @db.VarChar(191)
  providerSubscriptionId String? @db.VarChar(191)

  // Per-workspace price override
  priceOverrideMonthly Int?       // cents
  priceOverrideYearly  Int?       // cents
  currency             String?    @db.VarChar(10) // "USD"
  discountNote         String?    @db.VarChar(300)
  discountEndsAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  billingEvents BillingEvent[]

  @@unique([tenantId, provider])
  @@index([tenantId, status])
  @@index([provider, providerSubscriptionId])
}


model TenantBillingState {
  tenantId   String
  periodStart DateTime
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodEnd DateTime
  status    BillingPeriodStatus @default(OPEN)

  rolloverRequests Int @default(0)

  planCode String @db.VarChar(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([tenantId, periodStart])
  @@index([periodStart])
  @@index([periodEnd])
}

model TenantUsageCounter {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodStart DateTime
  meter       MeterKey
  usedCount   Int      @default(0)
  version     Int      @default(0)

  @@unique([tenantId, periodStart, meter])
  @@index([tenantId, meter, periodStart])
}

model TenantUsageLedger {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodStart   DateTime
  meter         MeterKey
  delta         Int

  idempotencyKey String @unique
  sourceType     String
  sourceId       String?
  actorUserId    String?

  createdAt DateTime @default(now())

  @@index([tenantId, periodStart, meter])
}

model BillingEvent {
  id             String  @id @default(cuid())
  tenantId       String?
  subscriptionId String?

  type            String @db.VarChar(80)
  providerEventId String @unique @db.VarChar(191)

  payload Json

  createdAt DateTime @default(now())

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([subscriptionId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())

  actorUserId  String
  actorContext ActorContext
  tenantId     String?

  action String @db.VarChar(120)

  targetType String? @db.VarChar(80)
  targetId   String? @db.VarChar(191)

  targetUserId String?

  metadata  Json?
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(300)

  createdAt DateTime @default(now())

  actorUser  User    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  tenant     Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  targetUser User?   @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model FeatureFlag {
  id          String  @id @default(cuid())
  code        String  @unique @db.VarChar(80)
  description String?

  tenantFlags TenantFeatureFlag[]
}

model TenantFeatureFlag {
  tenantId      String
  featureFlagId String

  isEnabled Boolean @default(false)
  config    Json?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlag FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureFlagId])
}

model Record {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdByUserId String
    createdByUser   User @relation("RecordsCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)


  title       String @db.VarChar(160)
  type        RecordType
  description String?

  clientName  String? @db.VarChar(120)
  clientEmail String? @db.VarChar(191)

  amount   Decimal? @db.Decimal(12, 2)
  currency String?  @db.VarChar(10)

  visibility RecordVisibility @default(WORKSPACE)
  isSensitive Boolean @default(false)

  status RecordStatus @default(DRAFT)

  submitCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments     RecordAttachment[]
  evidenceLinks   RecordEvidenceLink[]
  approvalRequests ApprovalRequest[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, type])
}

model RecordAttachment {
  id String @id @default(cuid())

  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  storageProvider String @db.VarChar(30) // s3, r2, supabase
  objectKey       String @db.VarChar(300)
  fileName        String @db.VarChar(255)
  mimeType        String @db.VarChar(120)
  sizeBytes       Int
  sha256          String? @db.VarChar(64)

  // AI-ready
  aiExtractedText String?

  createdAt DateTime @default(now())

  @@index([recordId, createdAt])
}

model RecordEvidenceLink {
  id String @id @default(cuid())

  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  url   String @db.VarChar(800)
  label String? @db.VarChar(160)

  createdAt DateTime @default(now())

  @@index([recordId, createdAt])
}

model ApprovalRequest {
  id String @id @default(cuid())

  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // External approver
  approverEmail String @db.VarChar(191)
  approverName  String? @db.VarChar(120)

  // Token security: store only hash
  tokenHash String @unique @db.VarChar(64)

  status ApprovalRequestStatus @default(SENT)

  expiresAt  DateTime
  viewedAt   DateTime?
  respondedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  actions ApprovalAction[]

  @@index([recordId, createdAt])
  @@index([expiresAt])
  @@index([approverEmail])
}

model ApprovalAction {
  id String @id @default(cuid())

  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  action String @db.VarChar(20) // APPROVE / REJECT
  comment String?

  createdAt DateTime @default(now())

  @@index([approvalRequestId, createdAt])
}


//
// NextAuth Models (unchanged)
//
model AuthLinkChallenge {
  id                      String    @id @default(cuid())
  userId                  String
  email                   String    @db.VarChar(191)
  targetProvider          String    @db.VarChar(50)
  targetProviderAccountId String    @db.VarChar(191)
  targetProviderTenantId  String?   @db.VarChar(191)
  callbackUrl             String?   @db.VarChar(500)

  // SHA-256 hash of the raw token. Raw token never persisted beyond pendingRawToken.
  tokenHash               String    @unique @db.VarChar(64)

  // Raw token stored ONLY until the browser cookie is issued (seconds).
  // Cleared by /api/link/pending immediately after setting the cookie.
  // Never logged, never returned in API responses.
  pendingRawToken         String?   @db.VarChar(191)

  // Set when /api/link/pending issues the cookie.
  // Used as a gate in finalization — challenges that never reached the
  // browser are rejected.
  cookieIssuedAt          DateTime?

  expiresAt               DateTime
  consumedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Rate limiting for magic link sends (used by /api/link/send-email).
  lastSentAt              DateTime?
  sendCount               Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@index([pendingRawToken])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  // Microsoft Entra ID (azure-ad) returns ext_expires_in in the token response.
  // The adapter passes all token fields to account.create(), so this field must
  // exist in the schema or Prisma rejects the entire sign-in with a validation error.
  ext_expires_in    Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())

  // Sliding inactivity (global policy uses user.security)
  lastActivityAt DateTime @default(now())

  // MFA gating
  authLevel             SessionAuthLevel @default(FULL)
  mfaVerifiedAt         DateTime?
  mfaChallengeExpiresAt DateTime?

  // Revocation / hard logout
  revokedAt    DateTime?
  logoutReason String?  @db.VarChar(50)

  // Lightweight device telemetry
  ipFirstSeen String? @db.VarChar(64)
  lastIp      String? @db.VarChar(64)
  userAgent   String? @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([userId, authLevel])
  @@index([userId, revokedAt])
}

model RememberedDevice {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique @db.VarChar(64)

  label       String? @db.VarChar(80)
  userAgent   String? @db.VarChar(300)
  ipFirstSeen String? @db.VarChar(64)

  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}
