model Record {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdByUser   User @relation("RecordsCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)


  title       String @db.VarChar(160)
  type        RecordType
  description String?

  clientName  String? @db.VarChar(120)
  clientEmail String? @db.VarChar(191)

  visibility RecordVisibility @default(RESTRICTED)
  isSensitive Boolean @default(false)

  status RecordStatus @default(OPEN)

  submitCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  closedAt       DateTime? @db.Timestamptz(6)
  closedByUserId String?
  closedByUser   User?     @relation("RecordsClosedByUser", fields: [closedByUserId], references: [id], onDelete: SetNull)

  // Human-readable key (e.g. REQ-2026-000124) — backfilled via migration
  recordKey String? @db.VarChar(30)

  // Finance fields
  requestedAmount   Decimal?               @db.Decimal(14, 2)
  approvedAmount    Decimal?               @db.Decimal(14, 2)
  currencyCode      String?                @db.VarChar(10)
  amountIsEstimated Boolean                @default(false)
  isRecurring       Boolean                @default(false)
  recurrenceNotes   String?                @db.VarChar(500)
  budgetImpactType  RecordBudgetImpactType?
  taxAmount         Decimal?               @db.Decimal(14, 2)
  taxIncluded       Boolean?

  // Counterparty
  vendorName        String? @db.VarChar(160)
  payeeName         String? @db.VarChar(160)
  invoiceNumber     String? @db.VarChar(100)
  contractReference String? @db.VarChar(100)
  purchaseOrderRef  String? @db.VarChar(100)

  // Context / classification
  priority              RecordPriority @default(MEDIUM)
  businessJustification String?        @db.VarChar(2000)
  departmentName        String?        @db.VarChar(120)
  costCenterCode        String?        @db.VarChar(60)

  // Financial config references (controlled master data)
  // departmentName and costCenterCode text fields are preserved for
  // backward compat — new requests use these FK references instead
  departmentId String?
  department   TenantDepartment? @relation("RecordDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   TenantCostCenter? @relation("RecordCostCenter", fields: [costCenterId], references: [id], onDelete: SetNull)

  // Timing
  neededByDate    DateTime? @db.Timestamptz(6)
  submittedAt     DateTime? @db.Timestamptz(6)
  approvedAt      DateTime? @db.Timestamptz(6)
  firstResponseAt DateTime? @db.Timestamptz(6)

  // Governance / risk flags
  hasPolicyException      Boolean          @default(false)
  policyExceptionReason   String?          @db.VarChar(1000)
  isOverBudget            Boolean          @default(false)
  missingRequiredEvidence Boolean          @default(false)
  possibleDuplicate       Boolean          @default(false)
  riskLevel               RecordRiskLevel?
  requiresFinanceReview   Boolean          @default(false)

  // Close reason (for richer close flow)
  closeReason      RecordCloseReason?
  closeReasonNotes String?          @db.VarChar(1000)

  // Approval summary (denormalized for list performance)
  approvalStatus RecordApprovalStatus @default(NOT_STARTED)

  // SLA / aging (derived, updated by server)
  overdue Boolean @default(false)

  attachments      RecordAttachment[]
  evidenceLinks    RecordEvidenceLink[]

  events       RecordEvent[]
  participants RecordParticipant[]
  access       RecordAccess[]
  comments     RecordComment[]
  links        RecordLink[]         @relation("RecordLinkFrom")
  linksTo      RecordLink[]         @relation("RecordLinkTo")
  evidence     RecordEvidence[]     @relation("RecordEvidenceItems")
  payment      RecordPayment?
  reminderLogs RecordReminderLog[]
  exports      RecordExport[]
  financeStatus               FinanceStatus @default(NOT_REQUIRED)
  financeAssignedMembershipId String?
  financeAssignedAt           DateTime? @db.Timestamptz(6)
  financeAssignedByRuleId     String?
  financeAssignedMembership   TenantMembership? @relation("MembershipAssignedRecords", fields: [financeAssignedMembershipId], references: [id], onDelete: SetNull)
  financeAssignedByRule       FinanceAssignmentRule? @relation("RecordFinanceAssignedByRule", fields: [financeAssignedByRuleId], references: [id], onDelete: SetNull)
  assignmentEvaluations       FinanceAssignmentEvaluation[] @relation("RecordAssignmentEvaluations")
  approvalRoutingEvaluations  ApprovalRoutingEvaluation[] @relation("RecordApprovalRoutingEvaluations")

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, createdByUserId, createdAt])
  @@index([tenantId, closedAt])
  @@index([tenantId, priority])
  @@index([tenantId, neededByDate])
  @@index([tenantId, overdue])
  @@index([tenantId, approvalStatus])
  @@index([tenantId, departmentId])
  @@index([tenantId, costCenterId])
  @@index([tenantId, financeStatus, financeAssignedAt])
  @@index([tenantId, financeAssignedMembershipId, financeStatus])
  @@index([recordKey])
}

