model Tenant {
  id     String       @id @default(cuid())
  name   String
  slug   String       @unique @db.VarChar(80)
  status TenantStatus @default(ACTIVE)

  // A5: first-time setup — creator and claim time
  createdByUserId String
  createdByUser   User   @relation("TenantCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  claimedAt       DateTime?

  // Workspace settings (A1)
  logoObjectKey String?  @db.VarChar(512)
  timezone      String?  @db.VarChar(64)
  currency      String?  @db.VarChar(10)
  dateFormat    String?  @db.VarChar(32)
  description   String?  @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships TenantMembership[]
  invitations TenantInvitation[]

  records Record[]

  departments TenantDepartment[] @relation("TenantDepartments")
  costCenters TenantCostCenter[] @relation("TenantCostCenters")
  financeTeams FinanceTeam[]     @relation("TenantFinanceTeams")
  financeSettings TenantFinanceSettings? @relation("TenantFinanceSettings")
  delegations ApprovalDelegation[] @relation("TenantDelegations")
  financeAssignmentRules FinanceAssignmentRule[] @relation("TenantAssignmentRules")
  financeAssignmentEvaluations FinanceAssignmentEvaluation[] @relation("TenantAssignmentEvaluations")
  approvalRoutingRules ApprovalRoutingRule[] @relation("TenantApprovalRoutingRules")
  approvalRoutingEvaluations ApprovalRoutingEvaluation[] @relation("TenantApprovalRoutingEvaluations")
  webhookEndpoints  WebhookEndpoint[] @relation("TenantWebhookEndpoints")
  webhookDeliveries WebhookDelivery[] @relation("TenantWebhookDeliveries")

  tenantRoles   TenantRole[]
  subscriptions Subscription[]

  auditLogs AuditLog[]

  featureFlags TenantFeatureFlag[]

  billingEvents BillingEvent[]

  workspaceMemberSecurity WorkspaceMemberSecurity[]

  tenantBillingStates   TenantBillingState[]
  tenantUsageCounters   TenantUsageCounter[]
  tenantUsageLedgers    TenantUsageLedger[]
  billingTransactions  BillingTransaction[]

  /// EPIC 5: Billing profile snapshot (future invoices; Country/Postal locked).
  tenantBillingProfile   TenantBillingProfile?
  /// EPIC 5: Support requests for existing invoice billing detail changes.
  billingSupportRequests BillingSupportRequest[]
  /// EPIC 5: Rollover lots (paid plans; 60d expiry, cap 400 for Starter).
  tenantRolloverLots    TenantRolloverLot[]
  /// EPIC 5: Scheduled overage charges (Starter; one-time on next invoice).
  tenantOverageCharges  TenantOverageCharge[]

  supportTickets            SupportTicket[]
  backgroundJobs            BackgroundJob[]
  knowledgeBaseSearchLogs   KnowledgeBaseSearchLog[]

  recordEvents              RecordEvent[]              @relation("TenantRecordEvents")
  recordParticipants        RecordParticipant[]        @relation("TenantRecordParticipants")
  recordAccess              RecordAccess[]             @relation("TenantRecordAccess")
  recordComments            RecordComment[]            @relation("TenantRecordComments")
  recordCommentMentions     RecordCommentMention[]     @relation("TenantRecordCommentMentions")
  recordLinks               RecordLink[]               @relation("TenantRecordLinks")
  recordEvidence            RecordEvidence[]           @relation("TenantRecordEvidence")
  recordPayments            RecordPayment[]            @relation("TenantRecordPayments")
  recordPaymentEvidence     RecordPaymentEvidence[]    @relation("TenantRecordPaymentEvidence")
  recordReminderLogs        RecordReminderLog[]        @relation("TenantRecordReminderLogs")
  recordExports             RecordExport[]             @relation("TenantRecordExports")

  @@index([status])
  @@index([createdByUserId])
  @@index([createdByUserId, status])
  @@index([createdAt, id])
}

/// EPIC 4: Transaction history for Billing tab (invoice link, display). No PII stored.
model BillingTransaction {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider               String    @db.VarChar(30)
  providerTransactionId  String    @unique @db.VarChar(191)

  status                 String    @db.VarChar(40)
  billedAt               DateTime?

  currency               String    @db.VarChar(10)
  subtotalCents          Int
  taxCents               Int
  totalCents             Int

  /// Paddle invoice id (inv_xxx) from transaction.completed; used to fetch hosted_invoice_url on "Open".
  providerInvoiceId      String?   @db.VarChar(191)
  invoiceUrl             String?   @db.VarChar(600)
  receiptNumber          String?   @db.VarChar(120)

  planCode               String?   @db.VarChar(50)
  subscriptionId         String?
  providerSubscriptionId String?   @db.VarChar(191)

  /// Invoice-specific edit: revised once via Paddle "Revise transaction customer details".
  revisedAt              DateTime?
  revisedByUserId        String?   @db.VarChar(191)
  revisionRequestPayload Json?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId, billedAt])
  @@index([tenantId, status])
  @@index([provider, providerSubscriptionId])
}

/// EPIC 5: Billing profile snapshot for future invoices. Country/Postal locked (set by Paddle checkout).
model TenantBillingProfile {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  countryCode String   @db.VarChar(2)
  postalCode  String?  @db.VarChar(32)
  region      String?  @db.VarChar(80)
  city        String?  @db.VarChar(80)
  addressLine1 String? @db.VarChar(120)
  addressLine2 String? @db.VarChar(120)
  companyName  String? @db.VarChar(160)
  vatId        String? @db.VarChar(64)

  providerCustomerId String? @db.VarChar(191)
  providerBusinessId String? @db.VarChar(191)
  providerAddressId  String? @db.VarChar(191)

  lastSyncedAt DateTime?
  syncSource   String?   @db.VarChar(40)

  updatedByUserId String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([providerCustomerId])
  @@index([lastSyncedAt])
}

/// EPIC 5: Support request for existing invoice billing detail changes (platform admin handles).
model BillingSupportRequest {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type   BillingSupportRequestType
  status BillingSupportRequestStatus @default(OPEN)

  providerInvoiceId     String? @db.VarChar(191)
  providerTransactionId String? @db.VarChar(191)
  requestedData         Json
  note                  String? @db.VarChar(500)

  createdByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

/// EPIC 5: Rollover lots (paid plans); expiry 60d, cap 400 for Starter.
model TenantRolloverLot {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  periodStart DateTime
  granted     Int
  used        Int      @default(0)
  expiresAt   DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, expiresAt])
  @@index([tenantId, periodStart])
}

/// EPIC 5: Scheduled overage charges (Starter; one-time on next invoice).
model TenantOverageCharge {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart DateTime

  meter         MeterKey
  units         Int
  unitPriceCents Int
  totalCents    Int

  provider         String  @db.VarChar(30)
  providerChargeId String? @db.VarChar(191)
  status           String  @db.VarChar(40)

  createdAt DateTime @default(now())

  @@unique([tenantId, periodStart, meter])
  @@index([tenantId, createdAt])
}

model TenantMembership {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  status     MembershipStatus @default(ACTIVE)
  joinedAt   DateTime?
  lastSeenAt DateTime?
  /// Set when the user dismisses the auto-workspace welcome banner.
  welcomeBannerDismissedAt DateTime?

  isDefaultTenant Boolean @default(false)
  workspaceRole         WorkspaceRole         @default(MEMBER)
  financialAccess       FinancialAccessScope  @default(OWN_AND_PARTICIPATING)
  financeResponsibility FinanceResponsibility @default(NONE)
  billingAccess         BillingAccessLevel    @default(NONE)

  /// Availability — doc 04 Section 3
  availability       MembershipAvailability @default(AVAILABLE)
  availabilityReason String?                @db.VarChar(500)
  unavailableUntil   DateTime?              @db.Timestamptz(6)

  /// Denormalized workload counter — doc 02 Section 4 / D-006
  financeOpenAssignmentsCount Int @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles        TenantUserRole[]
  financeTeams FinanceTeamMember[] @relation("MembershipFinanceTeams")
  delegationsGranted  ApprovalDelegation[] @relation("DelegationDelegator")
  delegationsReceived ApprovalDelegation[] @relation("DelegationDelegate")
  assignedRecords Record[] @relation("MembershipAssignedRecords")

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([tenantId, joinedAt])
  @@index([userId, status, isDefaultTenant, joinedAt])
  @@index([tenantId, workspaceRole])
