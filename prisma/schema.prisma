model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // L1 My Account: profile and appearance
  phone                 String?         @db.VarChar(30)
  timezone              String?         @db.VarChar(64)
  appearance           AppearanceMode   @default(SYSTEM)
  profilePhotoObjectKey String?         @db.VarChar(512)

  // If you later move to an IdP, these fields become useful
  identityProvider String? @db.VarChar(50)
  identityId       String? @db.VarChar(191)

  isPlatformBlocked Boolean @default(false)

  locale String @db.VarChar(5) @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  rememberedDevices RememberedDevice[]
  webAuthnCredentials WebAuthnCredential[]
  otpSessionTokens   OtpSessionToken[]

  security UserSecurity?

  tenantMemberships TenantMembership[]
  vendorUserRoles   VendorUserRole[]

  auditLogsAsActor  AuditLog[] @relation("AuditActor")
  auditLogsAsTarget AuditLog[] @relation("AuditTargetUser")

  tenantInvitationsSent   TenantInvitation[] @relation("TenantInvitedByUser")
  tenantInvitationsRejected TenantInvitation[] @relation("TenantInvitationRejectedByUser")
  vendorInvitationsSent   VendorInvitation[] @relation("VendorInvitedByUser")
  recordsCreated Record[] @relation("RecordsCreatedByUser")
  tenantsCreated Tenant[] @relation("TenantCreatedByUser")
  workspaceMemberSecurity WorkspaceMemberSecurity[] @relation("WorkspaceMemberSecurity")
  authLinkChallenges AuthLinkChallenge[]
  accountLinkIntents AccountLinkIntent[]

  kbCategoriesCreated    KnowledgeBaseCategory[]        @relation("KbCategoryCreatedBy")
  kbCategoriesUpdated    KnowledgeBaseCategory[]        @relation("KbCategoryUpdatedBy")
  kbArticlesCreated      KnowledgeBaseArticle[]         @relation("KbArticleCreatedBy")
  kbArticlesUpdated      KnowledgeBaseArticle[]         @relation("KbArticleUpdatedBy")
  kbRevisionsCreated     KnowledgeBaseArticleRevision[]   @relation("KbRevisionCreatedBy")
  kbSearchLogs           KnowledgeBaseSearchLog[]
  ticketsCreated         SupportTicket[]                @relation("TicketCreatedBy")
  ticketsAsRequester     SupportTicket[]                @relation("TicketRequester")
  ticketsAssigned      SupportTicket[]                @relation("TicketAssignee")
  ticketMessagesAuthored SupportTicketMessage[]         @relation("MessageAuthor")
  notifications         UserNotification[]
  aiChatSessions         AiChatSession[]

  recordEventActors            RecordEvent[]            @relation("RecordEventActor")
  recordParticipations         RecordParticipant[]      @relation("RecordParticipantUser")
  recordParticipationsCreated  RecordParticipant[]      @relation("RecordParticipantCreatedBy")
  recordAccessEntries          RecordAccess[]           @relation("RecordAccessUser")
  recordAccessGranted          RecordAccess[]           @relation("RecordAccessGrantedBy")
  recordCommentAuthors         RecordComment[]          @relation("RecordCommentAuthor")
  recordCommentMentions        RecordCommentMention[]   @relation("RecordCommentMentionedUser")
  recordLinkCreated            RecordLink[]             @relation("RecordLinkCreatedBy")
  recordLinkRemoved            RecordLink[]             @relation("RecordLinkRemovedBy")
  recordsClosedBy              Record[]                 @relation("RecordsClosedByUser")
  recordEvidenceCreated        RecordEvidence[]         @relation("RecordEvidenceCreatedBy")
  recordEvidenceDeleted        RecordEvidence[]         @relation("RecordEvidenceDeletedBy")
  recordPaymentSetBy           RecordPayment[]         @relation("RecordPaymentSetBy")
  recordPaymentEvidenceCreated RecordPaymentEvidence[]  @relation("RecordPaymentEvidenceCreatedBy")
  recordPaymentEvidenceRemoved RecordPaymentEvidence[]  @relation("RecordPaymentEvidenceRemovedBy")
  recordReminderLogsSent       RecordReminderLog[]     @relation("RecordReminderLogSentBy")
  recordExportsCreated         RecordExport[]           @relation("RecordExportCreatedBy")

  departmentsCreated TenantDepartment[] @relation("DepartmentCreatedBy")
  departmentsUpdated TenantDepartment[] @relation("DepartmentUpdatedBy")
  costCentersCreated TenantCostCenter[] @relation("CostCenterCreatedBy")
  costCentersUpdated TenantCostCenter[] @relation("CostCenterUpdatedBy")

  financeTeamsCreated FinanceTeam[]       @relation("FinanceTeamCreatedBy")
  financeTeamsDeleted FinanceTeam[]       @relation("FinanceTeamDeletedBy")
  financeTeamsAdded   FinanceTeamMember[] @relation("FinanceTeamMemberAddedBy")
  delegationsCreated  ApprovalDelegation[] @relation("DelegationCreatedBy")
  delegationsRevoked  ApprovalDelegation[] @relation("DelegationRevokedBy")
  financeAssignmentRulesCreated FinanceAssignmentRule[] @relation("FinanceAssignmentRuleCreatedBy")
  approvalRoutingRulesCreated ApprovalRoutingRule[] @relation("ApprovalRoutingRuleCreatedBy")
  webhookEndpointsCreated WebhookEndpoint[] @relation("WebhookEndpointCreatedBy")

  @@index([identityProvider, identityId])
}

/// Short-lived token for Settings → Link Google / Link Microsoft (email must match account).
model AccountLinkIntent {
  id             String    @id @default(cuid())
  userId         String
  targetProvider String    @db.VarChar(50)
  expectedEmail  String    @db.VarChar(191)
  tokenHash      String    @unique @db.VarChar(64)
  expiresAt      DateTime
  consumedAt     DateTime?
  // Set on email mismatch during Settings linking — redirect callback sends user back to Security.
  errorCode      String?   @db.VarChar(50)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
}

model UserSecurity {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // For forced logout / session invalidation
  tokenVersion Int @default(0)

  // L1: TOTP 2FA
  totpEnabled          Boolean   @default(false)
  totpEnabledAt        DateTime?
  totpSecretEnc        String?   @db.VarChar(500)
  totpPendingSecretEnc String?   @db.VarChar(500)
  backupCodeHashes     String[]  @default([])
  backupCodesGeneratedAt DateTime?

  // L1: Inactivity auto-logout (minutes: 15, 30, 60, 480, 10080, 21600). Default 21600 = 15 days.
  autoLogoutEnabled   Boolean @default(false)
  autoLogoutMinutes   Int     @default(21600)
  forceLogoutAt       DateTime?

  // Mirror flags (actual MFA is typically enforced at IdP level)
  mfaEnabled  Boolean   @default(false)
  mfaEnforced Boolean   @default(false)
  mfaEnforcedByUserId String?  // E6: admin who forced 2FA
  mfaResetAt  DateTime?

  /// Set when user completes step-up verification. Used when Session row is unavailable.
  stepUpVerifiedAt DateTime?

  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // WebAuthn registration challenge (one-time, short-lived)
  webAuthnChallenge          String?   @db.VarChar(512)
  webAuthnChallengeExpiresAt DateTime?

  @@index([totpEnabled])
  @@index([autoLogoutEnabled])
  @@index([mfaEnforced])
}

/// E6: Per-workspace 2FA enforcement (decouples from global UserSecurity).
model WorkspaceMemberSecurity {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String

  mfaEnforced      Boolean   @default(false)
  enforcedByUserId  String?
  enforcedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("WorkspaceMemberSecurity", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

