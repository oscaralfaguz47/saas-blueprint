/// NOTE: A composite (status, visibility) PARTIAL index exists in the database
/// (created by migration 20260324201000_add_hnsw_index_kb_chunks/migration.sql)
/// with WHERE status = 'PUBLISHED'. Prisma's schema cannot model partial indexes,
