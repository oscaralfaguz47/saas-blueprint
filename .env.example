# =============================================================================
# Copy to .env.local and fill in real values. Never commit secrets.
# This file is safe to commit — placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Primary PostgreSQL connection (use a pooler URL in production / serverless).
# Local dev: use a pgvector-enabled Postgres (see docker-compose.yml: pgvector/pgvector:pg16).
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"
# Direct connection for Prisma migrations only (not the pooler URL).
DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"
#
# Neon (staging/production): run once per database before vector migrations:
#   CREATE EXTENSION IF NOT EXISTS vector;
# See docs/NEON_PGVECTOR.md

# -----------------------------------------------------------------------------
# Authentication (NextAuth)
# -----------------------------------------------------------------------------
# Canonical site URL for OAuth callbacks and magic links. Use https in production.
# Local HTTP: http://localhost:3000 — Local HTTPS: https://localhost:3000 (with --experimental-https)
NEXTAUTH_URL="http://localhost:3000"
# Optional: internal URL when the app is behind a proxy (middleware CORS / edge).
NEXTAUTH_URL_INTERNAL=""
# JWT/session encryption secret — min 32 chars; generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars-long"
# Shown in 2FA authenticator apps as the issuer. Optional; defaults vary by screen.
APP_NAME="My App"

# OAuth — Google (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# OAuth — GitHub (optional)
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# OAuth — Microsoft Entra ID (optional)
MICROSOFT_ENTRA_ID_CLIENT_ID="your-microsoft-entra-id-client-id"
MICROSOFT_ENTRA_ID_CLIENT_SECRET="your-microsoft-entra-id-client-secret"
MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/your-tenant-id/v2.0"

# WebAuthn / passkeys — relying party display name (optional; falls back to APP_NAME).
WEBAUTHN_RP_NAME="My App"

# -----------------------------------------------------------------------------
# Application (public)
# -----------------------------------------------------------------------------
# Public base URL for absolute links when the request has no Host (e.g. some emails/cron).
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# -----------------------------------------------------------------------------
# Billing (Paddle)
# -----------------------------------------------------------------------------
# sandbox | production — must match your Paddle dashboard and API keys.
PADDLE_ENVIRONMENT="sandbox"
# Server-side API key from Paddle > Developer tools > Authentication > API keys.
PADDLE_API_KEY=""
# Client-side token for Paddle.js (safe to expose). Prefix test_ (sandbox) or live_ (production).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Webhook signing secret from Paddle > Developer tools > Notifications.
# Use PADDLE_WEBHOOK_SECRET or PADDLE_WEBHOOK_SECRET_CURRENT during rotation.
PADDLE_WEBHOOK_SECRET=""
# PADDLE_WEBHOOK_SECRET_CURRENT=""
# PADDLE_WEBHOOK_SECRET_PREVIOUS=""
# Price IDs from Paddle (sandbox vs live per environment).
PADDLE_PRICE_ID_STARTER=""
PADDLE_PRICE_ID_PRO=""
PADDLE_PRICE_ID_SCALE=""
PADDLE_PRICE_ID_STARTER_ANNUAL=""
PADDLE_PRICE_ID_PRO_ANNUAL=""
PADDLE_PRICE_ID_SCALE_ANNUAL=""
# Days of grace when subscription is past_due before hard limits (default 7 if unset).
PADDLE_GRACE_DAYS="7"
# Optional: User id used as audit actor for webhook-driven billing events (VENDOR context).
BILLING_WEBHOOK_ACTOR_USER_ID=""

# -----------------------------------------------------------------------------
# Storage (Cloudflare R2 — S3-compatible)
# -----------------------------------------------------------------------------
# From Cloudflare dashboard; see docs/R2_SETUP.md if present.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
# Optional: full public origin for R2 if you use a custom bucket URL (CSP img-src in next.config).
NEXT_PUBLIC_R2_BUCKET_URL=""

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Your Resend API key
RESEND_API_KEY="re_your-resend-api-key"

# Typed senders — configure all three in production.
# Each address must be a verified sender in your Resend dashboard.
# EMAIL_FROM is the fallback used when a typed sender is not set (dev/staging convenience only).
EMAIL_FROM="no-reply@yourdomain.com"
EMAIL_FROM_SECURITY="security@yourdomain.com"
EMAIL_FROM_NOTIFICATIONS="notifications@yourdomain.com"
EMAIL_FROM_SUPPORT="support@yourdomain.com"

# -----------------------------------------------------------------------------
# Platform administration
# -----------------------------------------------------------------------------
# First platform owner bootstrap; comma-separated extra admins optional.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# Optional: single inbox for public sales inquiries from /help/new
PLATFORM_ADMIN_EMAIL="sales@yourcompany.com"
PLATFORM_ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# -----------------------------------------------------------------------------
# Cron / internal APIs
# -----------------------------------------------------------------------------
# Bearer secret for /api/internal/cron/* (Vercel Cron or manual invocations).
CRON_SECRET="your-cron-bearer-secret-here"
# Optional: recipient for internal daily-email cron smoke tests.
CRON_EMAIL_TO="ops@yourdomain.com"
# Secret for POST /api/internal/billing/period-close (manual billing jobs).
BILLING_PERIOD_CLOSE_SECRET="your-period-close-secret-here"

# -----------------------------------------------------------------------------
# Outbound webhooks (tenant endpoints — E-3.5+)
# -----------------------------------------------------------------------------
# AES-256-GCM master key for encrypting webhook signing secrets at rest (64 hex chars = 32 bytes).
# Generate: openssl rand -hex 32
WEBHOOK_SECRET_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# -----------------------------------------------------------------------------
# AI — Help & Support Knowledge Base (server-only; optional)
# -----------------------------------------------------------------------------
# OpenAI API key must allow BOTH:
# - Chat completions (AI answers)
# - Embeddings (semantic search / KB indexing)
# If the key was created with only Chat completions, create a new key or add Embeddings in OpenAI dashboard.
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS="512"
# Embeddings (semantic search) — same AI_API_KEY as chat; OpenAI only for embeddings in this codebase.
EMBEDDING_MODEL="text-embedding-3-large"
EMBEDDING_DIMENSIONS="1536"
# Minimum cosine similarity for KB semantic search (0–1). Recommended 0.40 for text-embedding-3-large (1536 dims).
KB_SEARCH_SIMILARITY_THRESHOLD="0.40"

# -----------------------------------------------------------------------------
# Build / deploy (e.g. Vercel)
# -----------------------------------------------------------------------------
# If "true", run prisma db seed after migrate on deploy (scripts/vercel-build.cjs).
RUN_SEED="false"

# -----------------------------------------------------------------------------
# Runtime (usually set by Node/host — optional for local docs)
# -----------------------------------------------------------------------------
NODE_ENV="development"
