# Files and directories to ignore in Vercel deployments
.env
.env.local
.env.*.local
*.log
.DS_Store
node_modules
.next
.vercel
coverage
.vscode
.idea
*.swp
*.swo
*~

# Documentation (optional - remove if you want docs in deployment)
docs/
*.md
!README.md

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__/
tests/

# Development files
.prettierrc
.prettierignore
eslint.config.mjs
# Keep tsconfig.json - needed for path resolution
